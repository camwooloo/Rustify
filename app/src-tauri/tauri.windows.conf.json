{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/rustifyd.exe": "rustifyd.exe",
      "binaries/rustify-ctl.exe": "rustify-ctl.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}